PORT=3000
NODE_ENV=development

# MercadoLibre OAuth
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_USER_ID=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_TOKEN_STORE_PATH=/data/ml_tokens-prod.json
ML_PERSIST_TO_ENV_FILE=false

# Tiendanube
TN_USER_ID=
TN_ACCESS_TOKEN=
TN_USER_AGENT=SysCcv Corre con Ventaja

# ARCA / AFIP
ARCA_ENV=testing
ARCA_USE_REAL=false
ARCA_PRODUCTION_CONFIRMED=false
ARCA_CUIT=
ARCA_POINT_OF_SALE=1
ARCA_INVOICE_TYPE=11
ARCA_CERT_PATH=
ARCA_KEY_PATH=
ARCA_CERT_PEM=
ARCA_KEY_PEM=
ARCA_TA_STORE_DIR=/data/arca-tickets

# Facturación
INVOICE_DATA_DIR=/data/invoice-data
INVOICE_PDF_DIR=/data/invoices
INVOICE_WORKER_ENABLED=false
INVOICE_WORKER_INTERVAL_MS=300000
INVOICE_RETRY_ARCA_FAILED=false
INVOICE_ADMIN_TOKEN=

# Subida de factura a MercadoLibre
ML_UPLOAD_INVOICE_TO_ML=false
ML_ALLOW_NON_PRODUCTION_INVOICE_UPLOAD=false

# Debug temporal
DEBUG_INVOICE_JOBS=false
DEBUG_ARCA_CHECKS=false
